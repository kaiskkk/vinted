# Clé API Anthropic (https://platform.claude.com/settings/keys)
# Copie ce fichier en ".env" puis colle ta clé. Ne la commite jamais.
ANTHROPIC_API_KEY=sk-ant-...

# Port du serveur Express (optionnel, 3001 par défaut)
PORT=3001

# Niveau d'effort de Claude : low (rapide) | medium | high (plus réfléchi)
CLAUDE_EFFORT=low

# Code d'accès (optionnel) : s'il est défini, le site demande ce code avant d'utiliser Claude.
# Indispensable une fois le site en ligne (Netlify), pour que personne d'autre n'utilise ta clé.
CODE_ACCES=
