# IA gratuite : clé Google Gemini (https://aistudio.google.com/apikey, sans carte bancaire).
# Si elle est remplie, le site utilise Gemini à la place de Claude.
CLE_GEMINI=

# Modèle Gemini (optionnel) : gemini-flash-latest par défaut, ou par exemple gemini-flash-lite-latest
MODELE_GEMINI=

# Clé API Anthropic (https://platform.claude.com/settings/keys), payante, utilisée si CLE_GEMINI est vide.
# Copie ce fichier en ".env" puis colle ta clé. Ne la commite jamais.
ANTHROPIC_API_KEY=

# Port du serveur Express (optionnel, 3001 par défaut)
PORT=3001

# Niveau d'effort de Claude : low (rapide) | medium | high (plus réfléchi)
CLAUDE_EFFORT=low

# Code d'accès (optionnel) : s'il est défini, le site demande ce code avant d'utiliser l'IA.
# Conseillé une fois le site en ligne (Netlify), pour que personne d'autre n'utilise ta clé.
CODE_ACCES=
