# Clé API Anthropic (https://platform.claude.com/settings/keys)
# Copie ce fichier en ".env" puis colle ta clé. Ne la commite jamais.
ANTHROPIC_API_KEY=sk-ant-...

# Port du serveur Express (optionnel, 3001 par défaut)
PORT=3001

# Niveau d'effort de Claude : low (rapide) | medium | high (plus réfléchi)
CLAUDE_EFFORT=low
